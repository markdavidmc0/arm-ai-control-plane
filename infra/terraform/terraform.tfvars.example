# ==============================================================================
# Terraform Input Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to 'terraform.tfvars' (which is git-ignored by default):
#    cp terraform.tfvars.example terraform.tfvars
# 2. Fill in your actual environment values below.
# 3. Simply run 'terraform apply' without any -var flags!
# ==============================================================================

# --- Google Cloud Platform Settings ---
project_id = "sovereign-ai-495715"
region     = "us-central1"
zone       = "us-central1-a"

# --- Actions Runner Controller (ARC) Registration Token / App ---
github_target_repo          = "markdavidmc0/arm-developer-workspace"
# Provide EITHER a Personal Access Token (PAT with repo/admin:org scopes) OR GitHub App credentials:
github_pat                  = "ghp_YOUR_PERSONAL_ACCESS_TOKEN_HERE"
github_app_id               = ""
github_app_installation_id  = ""
github_app_private_key      = ""
