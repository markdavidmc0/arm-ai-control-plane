{
  "base_tools": [
    {
      "name": "mcp__search_tools",
      "description": "Lazy-loaded meta-tool. Allows agents to discover and fetch full schemas for unlisted tools on-demand without paying an upfront prompt token tax.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query keywords (e.g., 'bandwidth', 'sve', 'assembly')"
          },
          "domain": {
            "type": "string",
            "description": "Optional domain filter (e.g., 'physical-ai', 'cloud-ai', 'mobile-ai')"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "profile_and_optimize_kernel",
      "description": "Cross-compiles and profiles C++ inference kernels on Cortex-X925 target using Arm KleidiAI / NEON.",
      "parameters": {
        "type": "object",
        "properties": {
          "source_code": {
            "type": "string",
            "description": "C++ matrix or inference kernel source code."
          }
        },
        "required": [
          "source_code"
        ]
      }
    },
    {
      "name": "arm_official_hardware_telemetry",
      "description": "Queries real-time hardware telemetry counters from Official Arm Neoverse N2 cluster.",
      "parameters": {
        "type": "object",
        "properties": {
          "cluster_id": {
            "type": "string",
            "default": "neoverse-n2-node-01"
          }
        }
      },
      "upstream_server": "http://official-arm-mcp-service.default.svc.cluster.local:8000/mcp"
    },
    {
      "name": "arm_official_kleidiai_bench",
      "description": "Runs official KleidiAI GEMM micro-kernel benchmarks on Cortex-X925.",
      "parameters": {
        "type": "object",
        "properties": {
          "matrix_m": {
            "type": "integer",
            "default": 512
          },
          "matrix_n": {
            "type": "integer",
            "default": 512
          },
          "matrix_k": {
            "type": "integer",
            "default": 512
          }
        }
      },
      "upstream_server": "http://official-arm-mcp-service.default.svc.cluster.local:8000/mcp"
    }
  ],
  "domain_tools": {
    "physical-ai": [
      {
        "name": "ros2_pointcloud_voxelizer_profile",
        "description": "Profiles ROS 2 pointcloud voxelization pipelines for Arm Neoverse / Cortex-A robotics platforms.",
        "parameters": {
          "type": "object",
          "properties": {
            "voxel_size": {
              "type": "number",
              "default": 0.05
            },
            "point_count": {
              "type": "integer",
              "default": 100000
            }
          }
        }
      },
      {
        "name": "sensor_fusion_kalman_autotune",
        "description": "Auto-tunes 6-DOF Extended Kalman Filter (EKF) matrix vectorization for autonomous vehicle ECUs.",
        "parameters": {
          "type": "object",
          "properties": {
            "state_dimension": {
              "type": "integer",
              "default": 12
            }
          }
        }
      }
    ],
    "cloud-ai": [
      {
        "name": "vllm_sve_kv_cache_optimize",
        "description": "Optimizes LLM KV-cache memory bandwidth using Arm SVE2 vector gather/scatter instructions.",
        "parameters": {
          "type": "object",
          "properties": {
            "num_heads": {
              "type": "integer",
              "default": 32
            }
          }
        }
      },
      {
        "name": "vllm_arm_kv_cache_allocator_analyzer",
        "description": "Analyzes vLLM KV Cache allocation efficiency on Neoverse N2",
        "language": "python",
        "domain": "cloud-ai",
        "parameters": {
          "type": "object",
          "properties": {}
        }
      }
    ],
    "mobile-ai": [
      {
        "name": "executorch_kleidiai_quantize",
        "description": "Quantizes ExecuTorch operators to INT4/INT8 using KleidiAI micro-kernels for mobile NPU/CPU.",
        "parameters": {
          "type": "object",
          "properties": {
            "precision": {
              "type": "string",
              "enum": [
                "INT4",
                "INT8"
              ],
              "default": "INT8"
            }
          }
        }
      }
    ],
    "foundations": [
      {
        "name": "llvm_mca_assembly_analyzer",
        "description": "Runs LLVM Machine Code Analyzer (llvm-mca) on Arm assembly snippets to detect pipeline stalls and register spills.",
        "parameters": {
          "type": "object",
          "properties": {
            "asm_code": {
              "type": "string",
              "description": "Armv9-A assembly code block."
            }
          },
          "required": [
            "asm_code"
          ]
        }
      }
    ]
  },
  "upstream_servers": {
    "official-arm-mcp-cluster": {
      "server_id": "official-arm-mcp-cluster",
      "domain": "base",
      "endpoint_url": "http://official-arm-mcp.internal:8000/mcp",
      "tool_count": 2,
      "tool_names": [
        "arm_official_hardware_telemetry",
        "arm_official_kleidiai_bench"
      ]
    },
    "performix-mcp-cluster": {
      "server_id": "performix-mcp-cluster",
      "domain": "cloud-ai",
      "endpoint_url": "http://performix-mcp-service.default.svc.cluster.local:8080/mcp",
      "tool_count": 1,
      "tool_names": [
        "vllm_sve_kv_cache_optimize"
      ]
    },
    "arm-metis-mcp-cluster": {
      "server_id": "arm-metis-mcp-cluster",
      "domain": "hardware-and-systems",
      "endpoint_url": "http://arm-metis-mcp-service.default.svc.cluster.local:9000/mcp",
      "tool_count": 1,
      "tool_names": [
        "llvm_mca_assembly_analyzer"
      ]
    }
  }
}